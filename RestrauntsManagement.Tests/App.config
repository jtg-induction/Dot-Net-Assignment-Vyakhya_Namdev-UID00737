<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <appSettings>
	  <add key="JwtSecret" value="ThisIsMySuperSecretKey123456789012345" />
	  <add key="AccessTokenExpiryMinutes" value="15" />
  </appSettings>
  <connectionStrings>
    <add name="RestaurantDbContext" connectionString="Server=localhost;Database=RestaurantManagement;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
